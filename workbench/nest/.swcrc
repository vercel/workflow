{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "experimental": {
      "plugins": [
        ["@workflow/swc-plugin", { "mode": "client" }]
      ]
    }
  },
  "module": {
    "type": "es6"
  },
  "sourceMaps": true
}
