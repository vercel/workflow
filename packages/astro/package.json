{
  "name": "@workflow/astro",
  "version": "5.0.8",
  "description": "Astro integration for Workflow SDK",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/astro"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist"
  },
  "dependencies": {
    "@workflow/builders": "workspace:*",
    "@workflow/rollup": "workspace:*",
    "@workflow/vite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "astro": "7.4.7",
    "typescript": "catalog:"
  }
}
