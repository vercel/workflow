{
  "name": "@workflow/swc-plugin",
  "version": "5.0.2",
  "description": "SWC plugin for transforming Workflow SDK code",
  "license": "Apache-2.0",
  "type": "module",
  "main": "swc_plugin_workflow.wasm",
  "files": [
    "swc_plugin_workflow.wasm",
    "swc_plugin_workflow_swc116.wasm",
    "build-hash.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/swc-plugin-workflow"
  },
  "exports": {
    ".": "./swc_plugin_workflow.wasm",
    "./swc-1.16": "./swc_plugin_workflow_swc116.wasm",
    "./package.json": "./package.json",
    "./build-hash.json": "./build-hash.json"
  },
  "peerDependencies": {
    "@swc/core": ">=1.15.0 <1.17.0"
  },
  "keywords": [
    "swc-plugin"
  ],
  "scripts": {
    "build": "node build.js",
    "clean": "cargo clean",
    "test": "cargo test -p swc_workflow -p swc_workflow_swc116 && vitest run --config=../../vitest.config.ts test",
    "prepublishOnly": "pnpm build"
  },
  "preferUnplugged": true,
  "devDependencies": {
    "@swc/core": "catalog:",
    "swc-core-1-15-0": "npm:@swc/core@1.15.0",
    "swc-core-1-16": "npm:@swc/core@1.16.22",
    "swc-core-1-16-0": "npm:@swc/core@1.16.0",
    "vitest": "catalog:"
  }
}
