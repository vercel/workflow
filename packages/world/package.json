{
  "name": "@workflow/world",
  "version": "5.0.0-beta.33",
  "description": "The Workflows World interface",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./attributes-validation": {
      "types": "./dist/attributes-validation.d.ts",
      "default": "./dist/attributes-validation.js"
    },
    "./env-config": {
      "types": "./dist/env-config.d.ts",
      "default": "./dist/env-config.js"
    },
    "./event-metadata": {
      "types": "./dist/event-metadata.d.ts",
      "default": "./dist/event-metadata.js"
    },
    "./spec-version": {
      "types": "./dist/spec-version.d.ts",
      "default": "./dist/spec-version.js"
    },
    "./*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/world"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run src"
  },
  "dependencies": {
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@11.24.0"
}
