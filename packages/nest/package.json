{
  "name": "@workflow/nest",
  "version": "5.1.6",
  "description": "NestJS integration for Workflow SDK",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "workflow-nest": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./vercel-builder": {
      "types": "./dist/vercel-builder.d.ts",
      "import": "./dist/vercel-builder.js",
      "default": "./dist/vercel-builder.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run --config=../../vitest.config.ts src"
  },
  "dependencies": {
    "@swc/core": "catalog:",
    "@workflow/builders": "workspace:*",
    "@workflow/swc-plugin": "workspace:*",
    "@workflow/utils": "workspace:*",
    "esbuild": "catalog:",
    "pathe": "2.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@swc/cli": ">=0.4.0",
    "@swc/core": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@swc/cli": {
      "optional": true
    },
    "@swc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supports-color": "10.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/workflow.git",
    "directory": "packages/nest"
  }
}
