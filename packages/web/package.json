{
  "name": "@workflow/web",
  "description": "Workflow Observability UI",
  "version": "5.0.8",
  "type": "module",
  "private": false,
  "files": [
    "build",
    "server.js",
    "server.d.ts",
    "handler.js",
    "handler.d.ts",
    "registry.js",
    "registry.d.ts",
    "static.js",
    "package.json"
  ],
