{
  "name": "@workflow/sveltekit",
  "version": "5.0.8",
  "description": "SvelteKit integration for Workflow SDK",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/sveltekit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --config=../../vitest.config.ts src",
    "clean": "tsc --build --clean && rm -rf dist"
  },
  "dependencies": {
    "@sveltejs/load-config": "^0.2.3",
    "@workflow/builders": "workspace:*",
    "@workflow/rollup": "workspace:*",
    "@workflow/vite": "workspace:*",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "catalog:",
    "@workflow/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite": "7.3.7",
    "vitest": "catalog:"
  }
}
