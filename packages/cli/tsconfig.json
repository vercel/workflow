{
  "extends": "@workflow/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  // This test writes its fixtures with core's own sources, outside rootDir.
  // Vitest runs it from src.
  "exclude": ["node_modules", "src/lib/inspect/hydration-state.test.ts"]
}
